{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "frontend": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "define": {
              "LEXVAY_PRIMEUI_LICENSE": "\"\"",
              "LEXVAY_DEMO_ACCOUNTS": "[]"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "680kB",
                  "maximumError": "760kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "14kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "LEXVAY_PRIMEUI_LICENSE": "\"\"",
                "LEXVAY_DEMO_ACCOUNTS": "[{\"email\":\"dana.whitfield@northfield.example\",\"name\":\"Dana Whitfield\",\"role\":\"SIGNER\"},{\"email\":\"priya.raman@northfield.example\",\"name\":\"Dr. Priya Raman\",\"role\":\"REVIEWER\"},{\"email\":\"jordan.ellis@northfield.example\",\"name\":\"Jordan Ellis\",\"role\":\"CONTRIBUTOR\"},{\"email\":\"admin@northfield.example\",\"name\":\"Northfield Admin\",\"role\":\"ADMIN\"}]"
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "frontend:build:production"
            },
            "development": {
              "buildTarget": "frontend:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
