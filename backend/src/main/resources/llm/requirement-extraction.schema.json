{
  "type": "object",
  "additionalProperties": false,
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "title", "text", "type", "numeric_field", "numeric_operator", "numeric_value"],
        "properties": {
          "ref": { "type": "string", "description": "Short stable identifier, e.g. UT-3" },
          "title": { "type": "string", "description": "Five words or fewer naming the requirement" },
          "text": { "type": "string", "description": "The requirement, quoted or closely paraphrased from the rule text" },
          "type": { "type": "string", "enum": ["NUMERIC", "SUBJECT", "SUPERVISED_HOURS", "ACCREDITATION", "JURISDICTION_SPECIFIC"] },
          "numeric_field": { "type": ["string", "null"], "enum": ["TOTAL_CREDITS", "PRACTICUM_HOURS", "INTERNSHIP_HOURS", null] },
          "numeric_operator": { "type": ["string", "null"], "enum": [">=", "<=", "=", ">", "<", null] },
          "numeric_value": { "type": ["number", "null"] }
        }
      }
    }
  }
}
