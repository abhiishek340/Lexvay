# Lexvay configuration. Copy to .env for local development. Never commit .env.
# Values here are local development defaults, not secrets.

# Database (docker compose creates these roles from db/initdb/01-roles.sh)
LEXVAY_DB_URL=jdbc:postgresql://localhost:5432/lexvay
LEXVAY_DB_PORT=5432
LEXVAY_DB_NAME=lexvay
LEXVAY_DB_SUPERUSER_PASSWORD=postgres-dev
LEXVAY_DB_OWNER_USER=lexvay_owner
LEXVAY_DB_OWNER_PASSWORD=lexvay-owner-dev
LEXVAY_DB_APP_USER=lexvay_app
LEXVAY_DB_APP_PASSWORD=lexvay-app-dev

# Service
LEXVAY_PORT=8080
# Metrics (/actuator/prometheus) and the full health report. Keep this port off the public network.
LEXVAY_MANAGEMENT_PORT=8090
# How long a shutdown waits for the running job and open requests (a Spring duration)
LEXVAY_SHUTDOWN_GRACE=30s
# Spring profiles for the app container: prod (structured logs), or prod,oidc for single sign-on
LEXVAY_PROFILES=prod
# BUILD-TIME only (image build argument, read by `make image` and `docker compose build`; not a runtime variable):
# the PrimeNG license key, compiled into the front-end bundle. Never commit a real key; empty shows a license notice.
LEXVAY_PRIMEUI_LICENSE=
# Host ports for `docker compose --profile app up` (inside the container the ports stay 8080 and 8090)
LEXVAY_APP_PORT=8080
LEXVAY_APP_MANAGEMENT_PORT=8090

# Candidate page ranking for evidence matching: bm25 (default) or ts_rank, the baseline BM25 is measured against.
LEXVAY_MATCHING_RANKER=bm25

# Language model (milestone 4). Tests never use a real model.
# LEXVAY_LLM_PROVIDER is fake (scripted, demo data only), anthropic (billed; see the spend gate below) or
# openai-compatible (a server you run yourself; see "Local inference" in docs/OPERATIONS.md).
LEXVAY_LLM_PROVIDER=fake
# anthropic: empty means claude-sonnet-5-5. openai-compatible: required, the exact name your server serves; no default.
LEXVAY_LLM_MODEL=
LEXVAY_LLM_EFFORT=medium
# openai-compatible only. The base URL ends before /chat/completions, for example http://localhost:8089/v1 (llama-server)
# or http://localhost:11434/v1 (Ollama). Its host must be in LEXVAY_LLM_ALLOWED_HOSTS or the start fails; add a remote
# host there only when prompts may be sent to it. The key is optional. No per-call fee, so the spend gate does not apply.
LEXVAY_LLM_BASE_URL=
LEXVAY_LLM_API_KEY=
LEXVAY_LLM_TIMEOUT_SECONDS=120
# Every request asks for temperature 0. An integer here is also sent as the seed, so a run can be repeated on the same
# server and model; empty sends none.
LEXVAY_LLM_SEED=
LEXVAY_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Fake provider only (ignored, with one warning, for anthropic): comma-separated fake-llm.yml files whose extraction
# scripts are loaded at startup. scripts/e2e.sh sets it; leave it empty otherwise.
LEXVAY_LLM_FAKE_SCRIPTS=
ANTHROPIC_API_KEY=
# Spend gate (MODE-1). A metered provider (anthropic) is refused unless LEXVAY_LLM_PAID_APPROVED is true, the model has
# a price in LEXVAY_LLM_RATES (model=inputPerMtok:outputPerMtok, comma separated, USD; copy them from the provider's
# price list on the day you approve spending; this one table also prices GET /assessments/{id}/usage and the evaluation
# cost report, so for the scripted model use fake-llm=2.00:10.00 to see an illustrative cost) and the month's recorded cost plus the call's largest possible cost stays
# within LEXVAY_LLM_MONTHLY_BUDGET_USD. The defaults refuse every paid call. Never set these in a shared file.
LEXVAY_LLM_PAID_APPROVED=false
LEXVAY_LLM_MONTHLY_BUDGET_USD=0
LEXVAY_LLM_RATES=

# Evaluation (make eval, make eval-live). make eval-live follows LEXVAY_LLM_PROVIDER. openai-compatible measures a local
# model at no fee: set LEXVAY_LLM_BASE_URL and LEXVAY_LLM_MODEL, and the report is kept in eval/runs/ (gitignored).
# anthropic needs ANTHROPIC_API_KEY and the three spend-gate variables above with a price for the model, and does
# nothing without a key. LEXVAY_EVAL_DIR (default eval) holds golden.yml and thresholds.yml; set it only to try a
# different golden set.

# File store (milestone 2): local | s3
LEXVAY_FILESTORE=local
LEXVAY_FILESTORE_PATH=./data/files
LEXVAY_S3_BUCKET=

# Evidence package (F15): a package larger than this many bytes fails its job. The build writes the ZIP to the
# temporary directory first, so that much space must be free there.
LEXVAY_PACKAGE_MAX_BYTES=536870912

# Rule source monitoring (F12). Off by default: when true the service fetches the registered rule source URLs on the
# schedule below, which needs outbound internet access. Addresses on private networks are always refused.
LEXVAY_RULE_SOURCES_ENABLED=false
LEXVAY_RULE_SOURCES_POLL_INTERVAL_MS=300000

# Audit trail seal (SEC-3). How often the sealer chains new audit entries into the tamper-evident trail.
LEXVAY_AUDIT_SEAL_INTERVAL_MS=2000

# OCR for scanned PDFs (off | tesseract). tesseract needs the Tesseract binary: brew install tesseract, or apt install tesseract-ocr
LEXVAY_OCR=off
LEXVAY_OCR_TESSERACT_PATH=tesseract
LEXVAY_OCR_LANGUAGE=eng

# Demo tenant (milestone 6, local profile only)
LEXVAY_DEMO_PASSWORD=lexvay-demo

# Security (WS-SEC)
# Single sign-on: start the backend with SPRING_PROFILES_ACTIVE=oidc and set all three. Roles stay in Lexvay.
LEXVAY_OIDC_ISSUER_URI=
LEXVAY_OIDC_CLIENT_ID=
LEXVAY_OIDC_CLIENT_SECRET=
LEXVAY_OIDC_POST_LOGIN_URL=/
# true when the service is reached over HTTPS: marks the session cookie Secure
LEXVAY_COOKIE_SECURE=false
# native behind a load balancer, so client address and scheme come from X-Forwarded-For and X-Forwarded-Proto
LEXVAY_FORWARD_HEADERS=none
# Rate limits per instance per minute: login per client address, API and uploads per user
LEXVAY_RATELIMIT_LOGIN_PER_MINUTE=10
LEXVAY_RATELIMIT_API_PER_MINUTE=600
LEXVAY_RATELIMIT_UPLOAD_PER_MINUTE=30
# Upload size limit in MB
LEXVAY_UPLOAD_MAX_MB=25
# Password hashes that may run at once (32 MiB of heap each); empty means the processors, at least 2
LEXVAY_PASSWORD_HASH_CONCURRENCY=

# Build-time only (frontend): PrimeUI license key for PrimeNG 22 (docs/ROADMAP.md, owner decisions).
# Passed as `ng build --define "LEXVAY_PRIMEUI_LICENSE='<key>'"`; never committed.
# LEXVAY_PRIMEUI_LICENSE=
