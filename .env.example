# Lexvay configuration. Copy to .env for local development. Never commit .env.
# Values here are local development defaults, not secrets.

# Database (docker compose creates these roles from db/initdb/01-roles.sh)
LEXVAY_DB_URL=jdbc:postgresql://localhost:5432/lexvay
LEXVAY_DB_PORT=5432
LEXVAY_DB_NAME=lexvay
LEXVAY_DB_SUPERUSER_PASSWORD=postgres-dev
LEXVAY_DB_OWNER_USER=lexvay_owner
LEXVAY_DB_OWNER_PASSWORD=lexvay-owner-dev
LEXVAY_DB_APP_USER=lexvay_app
LEXVAY_DB_APP_PASSWORD=lexvay-app-dev

# Service
LEXVAY_PORT=8080

# Candidate page ranking for evidence matching: bm25 (default) or ts_rank, the baseline BM25 is measured against.
LEXVAY_MATCHING_RANKER=bm25

# Language model (milestone 4). Tests never use a real model.
LEXVAY_LLM_PROVIDER=fake
LEXVAY_LLM_MODEL=claude-sonnet-5-5
LEXVAY_LLM_EFFORT=medium
LEXVAY_LLM_PRICE_INPUT_PER_MTOK=2.00
LEXVAY_LLM_PRICE_OUTPUT_PER_MTOK=10.00
ANTHROPIC_API_KEY=

# Evaluation (make eval, make eval-live). make eval-live needs ANTHROPIC_API_KEY and the two prices above,
# reports tokens and cost, and does nothing without a key. LEXVAY_EVAL_DIR (default eval) holds golden.yml
# and thresholds.yml; set it only to try a different golden set.

# File store (milestone 2): local | s3
LEXVAY_FILESTORE=local
LEXVAY_FILESTORE_PATH=./data/files
LEXVAY_S3_BUCKET=

# Demo tenant (milestone 6, local profile only)
LEXVAY_DEMO_PASSWORD=lexvay-demo
